MONGO_URI=mongodb://localhost:27017/rbac_db
JWT_SECRET=replace-with-a-long-random-value

# Comma-separated browser origins allowed to use session cookies
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Use production with HTTPS to enable Secure session cookies (also disables demo creator seeding)
NODE_ENV=development

# Public URL path the API is served under (must match the nginx location).
# Local dev: /api   Production behind creator.cultmkt.com/portal: /portal/api
COOKIE_PATH=/api

# First Super Admin account (created only if it does not exist yet)
ADMIN_EMAIL=admin@rbac.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Super Admin

# --- Production example (creator.cultmkt.com/portal) ---
# NODE_ENV=production
# FRONTEND_ORIGINS=https://creator.cultmkt.com
# COOKIE_PATH=/portal/api
# JWT_SECRET=<openssl rand -hex 32>
# ADMIN_EMAIL=<your admin email>
# ADMIN_PASSWORD=<strong password>
