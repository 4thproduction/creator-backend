# Production build of the portal, served as static files by nginx.
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

# Public path the SPA lives under, and the API prefix the browser calls.
# With the defaults the app is at https://creator.cultmkt.com/portal/
# and calls https://creator.cultmkt.com/portal/api/...
ARG VITE_BASE_PATH=/portal/
ARG VITE_API_URL=/portal
ENV VITE_BASE_PATH=$VITE_BASE_PATH VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
